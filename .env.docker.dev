# ========================================================================
#  开发环境变量（hot-reload）
#  启动：docker compose --env-file .env.docker.dev -f docker-compose.dev.yml up
# ========================================================================

# ---- 对外暴露端口（唯一宿主机端口）----
WEB_PORT=8080

# ---- PostgreSQL ----
POSTGRES_USER=destiny
POSTGRES_PASSWORD=destiny_pwd
POSTGRES_DB=destiny

# ---- 安全密钥（开发可用默认值）----
JWT_ACCESS_SECRET=dev-access-secret-please-change
JWT_REFRESH_SECRET=dev-refresh-secret-please-change
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ---- 跨域 ----
CORS_ORIGIN=http://localhost:8080

# ---- LLM（开发默认走离线 Mock，无需 API Key）----
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
