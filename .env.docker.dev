# ========================================================================
#  开发环境变量（hot-reload）
#  启动：docker compose --env-file .env.docker.dev -f docker-compose.dev.yml up
# ========================================================================

# ---- 对外暴露端口（唯一宿主机端口）----
WEB_PORT=8080

# ---- PostgreSQL ----
POSTGRES_USER=destiny
POSTGRES_PASSWORD=destiny_pwd
POSTGRES_DB=destiny

# ---- 安全密钥（开发可用默认值）----
JWT_ACCESS_SECRET=dev-access-secret-please-change
JWT_REFRESH_SECRET=dev-refresh-secret-please-change
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ---- 跨域 ----
CORS_ORIGIN=http://localhost:8080

# ---- 接口限流 ----
THROTTLE_TTL=60
THROTTLE_LIMIT=30

# ---- LLM（开发默认走离线 Mock，无需 API Key）----
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-822b42d900214d1a9bbdaaec2db81ecd
LLM_BASE_URL=https://api.deepseek.com/v1 
LLM_MODEL=deepseek-v4-flash