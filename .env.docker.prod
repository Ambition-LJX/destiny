# ========================================================================
#  生产环境变量（上线前必须替换所有密钥）
#  启动：docker compose --env-file .env.docker.prod -f docker-compose.prod.yml up -d --build
#
#  生成强密钥：openssl rand -hex 32
# ========================================================================

# ---- 对外暴露端口（唯一宿主机端口，浏览器通过 ip:8080 访问）----
WEB_PORT=8080

# ---- PostgreSQL（请修改默认账号密码）----
POSTGRES_USER=destiny
POSTGRES_PASSWORD=destiny123456
POSTGRES_DB=destiny

# ---- 安全密钥（生产必须替换为随机强密钥） ----
# 生成示例：openssl rand -hex 32
JWT_ACCESS_SECRET=e4d7f1a8b3c6d9e2f5a8b1c4d7e0f3a6b9c2d5e8f1a4b7c0d3e6f9a2b5c8d1e4
JWT_REFRESH_SECRET=a7b0c3d6e9f2a5b8c1d4e7f0a3b6c9d2e5f8a1b4c7d0e3f6a9b2c5d8e1f4a7b0
# 出生信息加密密钥（任意长度，内部会派生为 32 字节）
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ---- 跨域 ----
CORS_ORIGIN=http://localhost:8080

# ---- LLM 大模型（可插拔，OpenAI 兼容协议） ----
# LLM_PROVIDER 为 mock 时使用内置离线适配器（无需 API Key，便于演示）
# 生产接入：设为 openai / deepseek / moonshot 等，并填入对应 API Key 与 baseUrl
LLM_PROVIDER=openai
LLM_API_KEY=sk-ws-H.EIHDYXY.iiZj.MEYCIQDnltU4Dc9_j9VNkEBgrfDDoy9OnqvCcrI_6NiYPk8k4QIhALxFggQI-eRDK4hnpvtDeWKZMJQw43JFA4l352ZjoTKQ
LLM_BASE_URL=https://llm-qohx79ebczeps167.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus