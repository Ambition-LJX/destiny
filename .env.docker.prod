# ========================================================================
#  生产环境变量
#  启动：docker compose --env-file .env.docker.prod -f docker-compose.prod.yml up -d --build
#  强密钥生成：openssl rand -hex 32
# ========================================================================

# ---- 对外暴露端口（唯一宿主机端口，浏览器通过 ip:8080 访问）----
WEB_PORT=8080

# ---- PostgreSQL ----
POSTGRES_USER=destiny
POSTGRES_PASSWORD=a7f3c9e1b4d8062f5e91c3a7b2d4f6e8091a3c5d7b2e4f6a8c0d2e4f6b8a0c
POSTGRES_DB=destiny

# ---- 安全密钥（必须替换为 openssl rand -hex 32 输出）----
JWT_ACCESS_SECRET=d4e6f8a0c2b4d6e8f0a2c4e6b8d0f2a4c6e8b0d2f4a6c8e0b2d4f6a8c0e2b4
JWT_REFRESH_SECRET=f0a2c4e6b8d0f2a4c6e8b0d2f4a6c8e0b2d4f6a8c0e2b4d6f8a0c2e4b6d8f0
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=b8d0f2a4c6e8b0d2f4a6c8e0b2d4f6a8c0e2b4d6f8a0c2e4b6d8f0a2c4e6b8

# ---- 跨域（部署上线前必须改为实际访问源，如 http://<server-ip>:8080）----
CORS_ORIGIN=http://localhost:8080

# ---- 接口限流（per-client，滑动窗口）----
THROTTLE_TTL=60
THROTTLE_LIMIT=30

# ---- LLM 大模型（OpenAI 兼容协议）----
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-822b42d900214d1a9bbdaaec2db81ecd
LLM_BASE_URL=https://api.deepseek.com/v1 
LLM_MODEL=deepseek-v4-flash