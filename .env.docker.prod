# ========================================================================
#  生产环境变量（上线前必须替换所有密钥）
#  启动：docker compose --env-file .env.docker.prod -f docker-compose.prod.yml up -d --build
#
#  生成强密钥：openssl rand -hex 32
# ========================================================================

# ---- 对外暴露端口（唯一宿主机端口，浏览器通过 ip:8080 访问）----
WEB_PORT=8080

# ---- PostgreSQL（请修改默认账号密码）----
POSTGRES_USER=destiny
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=destiny

# ---- 安全密钥（必须替换为随机强密钥）----
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_REFRESH_SECRET
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_ENCRYPTION_KEY

# ---- 跨域（改为实际访问地址，如 http://<server-ip>:8080 或 https://yourdomain.com）----
CORS_ORIGIN=http://<server-ip>:8080

# ---- LLM（生产建议接入真实大模型）----
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
