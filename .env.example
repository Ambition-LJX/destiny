# ========================================================================
#  Destiny 项目环境变量参考模板
#  - 开发环境请使用：.env.docker.dev
#  - 生产环境请使用：.env.docker.prod
#  启动方式见 DEPLOYMENT.md
# ========================================================================

# ---- 对外暴露端口（唯一宿主机端口，浏览器通过 ip:8080 访问）----
WEB_PORT=8080

# ---- PostgreSQL（仅容器内网访问，不映射到宿主机）----
POSTGRES_USER=destiny
POSTGRES_PASSWORD=destiny_pwd
POSTGRES_DB=destiny

# ---- 安全密钥（生产必须替换为随机强密钥：openssl rand -hex 32）----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# 出生信息加密密钥（任意长度，内部会派生为 32 字节）
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ---- 跨域（生产改为实际访问地址，如 http://<server-ip>:8080）----
CORS_ORIGIN=http://localhost:8080

# ---- LLM 大模型（OpenAI 兼容协议，mock 为离线模拟）----
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
