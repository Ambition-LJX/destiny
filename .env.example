# ========================================================================
#  Destiny 环境变量参考模板（不参与运行，请复制为 .env.docker.dev 或 .env.docker.prod）
#  启动方式见 DEPLOYMENT.md
# ========================================================================

# ---- 对外暴露端口（唯一宿主机端口，浏览器通过 ip:8080 访问）----
WEB_PORT=8080

# ---- PostgreSQL（仅容器内网访问，不映射到宿主机）----
POSTGRES_USER=destiny
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=destiny

# ---- 安全密钥（生产必须替换为随机强密钥：openssl rand -hex 32）----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 出生信息加密密钥（任意长度，内部会派生为 32 字节）
ENCRYPTION_KEY=change-me-encryption-key

# ---- 跨域（生产改为实际访问地址，如 http://<server-ip>:8080）----
CORS_ORIGIN=http://localhost:8080

# ---- 接口限流（per-client，滑动窗口）----
THROTTLE_TTL=60
THROTTLE_LIMIT=30

# ---- 管理接口令牌（成本统计等运营接口，请求头 x-admin-token；留空则禁用）----
ADMIN_TOKEN=change-me-admin-token

# ---- 解锁（扫码代收）：价格、微信/支付宝收款码图片地址、客服联系方式、pro 有效天数(0=永久) ----
BILLING_UNLOCK_PRICE=9.9
BILLING_QR_WECHAT=https://i.hd-r.cn/6883f1ef-eb9c-49b7-ace8-c05aa24beee5.jpg
BILLING_QR_ALIPAY=https://i.hd-r.cn/e404a509-70ee-477d-912c-d70ddac70097.jpg
BILLING_CONTACT=a19833722688
BILLING_PRO_DAYS=1

# ---- LLM 大模型（OpenAI 兼容协议，mock 为离线模拟）----
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini