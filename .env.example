# ================= 部署环境变量（复制为 .env 后按需修改） =================
# docker compose 会读取本文件。生产环境务必替换所有密钥。

# ---- 端口映射 ----
WEB_PORT=3000
API_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379

# ---- PostgreSQL ----
POSTGRES_USER=destiny
POSTGRES_PASSWORD=destiny_pwd
POSTGRES_DB=destiny

# ---- 安全密钥（生产必须替换为随机强密钥） ----
# 生成示例：openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
# 出生信息加密密钥（任意长度，内部会派生为 32 字节）
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ---- 跨域 ----
CORS_ORIGIN=http://localhost:3000

# ---- LLM 大模型（可插拔，OpenAI 兼容协议） ----
# LLM_PROVIDER 为 mock 时使用内置离线适配器（无需 API Key，便于演示）
# 生产接入：设为 openai / deepseek / moonshot 等，并填入对应 API Key 与 baseUrl
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
