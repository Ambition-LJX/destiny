# ===== 应用 =====
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# ===== 数据库 (PostgreSQL) =====
DATABASE_URL="postgresql://destiny:destiny@localhost:5432/destiny?schema=public"

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== JWT =====
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# ===== 敏感字段加密（任意长度，内部派生为 32 字节） =====
ENCRYPTION_KEY=change-me-please-32-bytes-secret

# ===== LLM 适配层 =====
# provider: openai | deepseek | moonshot | mock（留空或 mock 走离线模拟）
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ===== 限流 =====
THROTTLE_TTL=60
THROTTLE_LIMIT=30
