{
  "name": "destiny",
  "version": "1.0.0",
  "private": true,
  "description": "AI 八字命术系统 · 规则引擎排盘 + AI 自然语言解读",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "engine:build": "pnpm --filter @app/bazi-engine build",
    "engine:test": "pnpm --filter @app/bazi-engine test",
    "api:dev": "pnpm --filter @app/api start:dev",
    "web:dev": "pnpm --filter @app/web dev",
    "db:generate": "pnpm --filter @app/api prisma:generate",
    "db:migrate": "pnpm --filter @app/api prisma:migrate"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@9.12.0"
}
